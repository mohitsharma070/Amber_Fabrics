DirectoryIndex index.php
Options -Indexes

# Block direct access to environment and internal config files
<FilesMatch "^(\.env|\.env\..*|secure-config\.php|app-config\.php|composer\.(json|lock|phar)|phpunit\.xml|\.git|\.gitignore|\.gitattributes|\.htaccess|\.htaccess\.bak|README(\.md)?|CHANGELOG\.md|GO_LIVE_CHECKLIST\.md|SECURITY\.md|query)$">
	Require all denied
</FilesMatch>

# Block direct access to selected private folders
RedirectMatch 403 ^/(\.git|config|database|scripts|tmp|tmp_sessions|plugins|vendor|includes)(/|$)
RedirectMatch 403 ^/(tmp-debug-.*\.php|cron/(?!run-plugins\.php$).*)$
RedirectMatch 403 ^/(images|css|js|feeds)/.*\.(php[0-9]?|phtml|phar|cgi|pl|asp|aspx|jsp)$

<IfModule mod_headers.c>
	<FilesMatch "\.(?:css|js|jpg|jpeg|png|webp|gif|svg|ico|mp4|webm|ogg|xml|json)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
</IfModule>

RewriteEngine On

# Force HTTPS (skips localhost and 127.0.0.1 for local development)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^feeds/products\.(xml|json)$ index.php?url=feeds/products.$1 [L,QSA]

# Public, extensionless URLs. Keep payment callbacks, webhooks, and other
# machine-facing action endpoints on explicit .php URLs so third-party
# integrations are never redirected.
#
# Redirect only direct browser GET/HEAD requests for the public page allowlist.
# THE_REQUEST prevents a redirect loop after the internal rewrite below.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]|$) [NC]
RewriteRule ^index\.php$ / [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+(?:about|catalog|cart|checkout|contact|fabric|faq|international-buyers|international-orders-policy|order-success|privacy-policy|return-policy|shipping-policy|size-guide|terms|thank-you)\.php(?:[?\s]|$) [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+customer/(?:forgot-password|login|order-view|orders|profile|register|reset-password|support-tickets|verify-email)\.php(?:[?\s]|$) [NC]
RewriteRule ^customer/(forgot-password|login|order-view|orders|profile|register|reset-password|support-tickets|verify-email)\.php$ /customer/$1 [R=301,L,NE]

# Admin screens also use extensionless browser URLs. POST requests continue to
# work with existing explicit handlers and are not redirected.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+admin/index\.php(?:[?\s]|$) [NC]
RewriteRule ^admin/index\.php$ /admin/ [R=301,L,NE]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+admin/[A-Za-z0-9-]+\.php(?:[?\s]|$) [NC]
RewriteRule ^admin/([A-Za-z0-9-]+)\.php$ /admin/$1 [R=301,L,NE]

# Preserve POST bodies and multipart uploads while canonicalizing legacy admin
# form actions. A temporary 307 avoids caching a method-preserving redirect.
RewriteCond %{REQUEST_METHOD} !^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+admin/[A-Za-z0-9-]+\.php(?:[?\s]|$) [NC]
RewriteRule ^admin/([A-Za-z0-9-]+)\.php$ /admin/$1 [R=307,L,NE]

# Serve the public allowlist without exposing the .php filename. Query strings
# are retained, for example /fabric?id=123 and /catalog?category=cotton.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(about|catalog|cart|checkout|contact|fabric|faq|international-buyers|international-orders-policy|order-success|privacy-policy|return-policy|shipping-policy|size-guide|terms|thank-you)$ $1.php [L]

# Customer screens use clean URLs too. POST submissions still target their
# explicit PHP handlers and are deliberately excluded from the redirects above.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^customer/(forgot-password|login|order-view|orders|profile|register|reset-password|support-tickets|verify-email)$ customer/$1.php [L]

# Resolve a clean top-level admin route only when the corresponding PHP screen
# exists. Nested private includes such as admin/partials are not exposed.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^admin/([A-Za-z0-9-]+)$ admin/$1.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^(.+)$ index.php?url=$1 [L,QSA]
